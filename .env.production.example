# Copy to .env.production and replace every example path/domain before use.
# Secret contents must live in files outside Git; Compose mounts them through
# /run/secrets. Do not put secret values in this file.
AIOPS_BACKEND_IMAGE_REF=ghcr.io/REPLACE_OWNER/agent-ops-backend@sha256:REPLACE_WITH_SIGNED_DIGEST
AIOPS_FRONTEND_IMAGE_REF=ghcr.io/REPLACE_OWNER/agent-ops-frontend@sha256:REPLACE_WITH_SIGNED_DIGEST
AIOPS_HTTPS_BIND=0.0.0.0
AIOPS_HTTPS_PORT=443
AIOPS_TRUSTED_ORIGINS=https://ops.example.com
AIOPS_RELEASE_DIGEST=sha256:REPLACE_WITH_IMMUTABLE_BACKEND_IMAGE_DIGEST
AIOPS_COMMIT_SHA=REPLACE_WITH_REVIEWED_GIT_COMMIT_SHA

# Paths are resolved relative to deploy/compose.prod.yml.
AIOPS_SESSION_SECRET_FILE_HOST=./secrets/session_secret
AIOPS_TLS_CERT_FILE_HOST=./secrets/tls_cert.pem
AIOPS_TLS_KEY_FILE_HOST=./secrets/tls_key.pem

# Production is fail-closed: select exactly one active provider per deployment.
# Built-ins: deepseek, moonshot, zhipu. openai_compatible is the extension lane.
# These values only define a candidate; GA remains NO-GO until that provider's
# independent live probe and policy review pass.
AIOPS_LLM_MODE=deepseek
AIOPS_LLM_ENABLED_PROVIDERS=deepseek
AIOPS_LLM_BASE_URL=https://api.deepseek.com
AIOPS_LLM_MODEL=deepseek-v4-flash
AIOPS_LLM_API_KEY_FILE_HOST=./secrets/llm_api_key
AIOPS_LLM_EVIDENCE_FILE_HOST=./secrets/llm-contract.json
AIOPS_LLM_EVIDENCE_SHA256=sha256:REPLACE_WITH_DIGEST_PRINTED_BY_PROBE

# First-install setup only. Use with deploy/compose.setup.yml, set an expiry no
# more than 15 minutes in the future, then remove the token file and override.
AIOPS_SETUP_TOKEN_FILE_HOST=./secrets/setup_token
AIOPS_SETUP_TOKEN_EXPIRES_AT=REPLACE_WITH_UTC_ISO8601_MAX_60_MINUTES_AHEAD
